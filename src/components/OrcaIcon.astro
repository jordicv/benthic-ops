---
interface Props {
  size?: number;
  variant?: 'color' | 'white' | 'black';
  class?: string;
}

const { size = 48, variant = 'color', class: className = '' } = Astro.props;

const height = Math.round(size * 130 / 220);

// Color config by variant
const bodyFill   = variant === 'white' ? '#ffffff'
                 : variant === 'black' ? '#000000'
                 : '#0a1628';

const accentStroke = variant === 'white' ? 'rgba(255,255,255,0.55)'
                   : variant === 'black' ? 'rgba(0,0,0,0.45)'
                   : '#00d4ff';

const accentFill   = variant === 'white' ? 'rgba(255,255,255,0.55)'
                   : variant === 'black' ? 'rgba(0,0,0,0.45)'
                   : '#00d4ff';

const bellyFill    = variant === 'color' ? 'white' : bodyFill;
const eyeFill      = variant === 'color' ? 'white' : bodyFill;
const pupilFill    = variant === 'color' ? bodyFill : (variant === 'white' ? 'rgba(220,235,255,0.6)' : 'rgba(255,255,255,0.15)');
---

<svg
  width={size}
  height={height}
  viewBox="0 0 220 130"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  fill="none"
>
  <!-- Tail flukes -->
  <path
    d="M 28,55 L 10,40 L 17,60 L 10,82 L 28,68 Z"
    fill={bodyFill}
  />

  <!-- Main body -->
  <path
    d="M 28,55
       C 30,50 40,44 57,42
       C 70,40 84,40 98,42
       C 116,44 138,46 158,48
       C 178,50 196,54 208,60
       C 216,64 218,70 215,75
       C 210,82 198,86 178,88
       C 158,90 128,90 100,88
       C 80,86 66,82 58,90
       C 50,96 36,100 26,97
       C 18,94 16,84 20,74
       C 22,66 26,60 28,55 Z"
    fill={bodyFill}
  />

  <!-- Dorsal fin -->
  <path
    d="M 93,42 C 97,26 107,12 115,7 C 121,15 125,30 121,43 Z"
    fill={bodyFill}
  />

  <!-- Pectoral fin -->
  <path
    d="M 62,82 C 56,90 46,100 38,104 C 46,100 62,92 66,82 Z"
    fill={bodyFill}
  />

  <!-- White belly patch (only in color variant, slightly different tones) -->
  {variant === 'color' && (
    <ellipse
      cx="158" cy="83"
      rx="27" ry="13"
      fill={bellyFill}
      transform="rotate(-7 158 83)"
    />
  )}

  <!-- White eye patch -->
  {variant === 'color' && (
    <ellipse
      cx="193" cy="60"
      rx="13" ry="9"
      fill={eyeFill}
      transform="rotate(-5 193 60)"
    />
  )}

  <!-- Black pupil -->
  {variant === 'color' && (
    <circle cx="195" cy="60" r="3.5" fill={pupilFill} />
  )}

  <!-- ══ CIRCUIT TRACES ══ -->
  <g
    stroke={accentStroke}
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  >
    <!-- Main horizontal trace -->
    <polyline points="68,62 96,62 96,50 130,50 130,62 157,62" />
    <!-- Branch: down-left toward pectoral -->
    <line x1="68"  y1="62" x2="55"  y2="75" />
    <!-- Branch: up toward dorsal fin -->
    <line x1="96"  y1="50" x2="96"  y2="38" />
    <!-- Branch: right toward head -->
    <line x1="157" y1="62" x2="170" y2="52" />
  </g>

  <!-- Circuit nodes -->
  <g fill={accentFill}>
    <circle cx="68"  cy="62" r="3.5" />
    <circle cx="96"  cy="62" r="3.5" />
    <circle cx="130" cy="62" r="3.5" />
    <circle cx="157" cy="62" r="3.5" />
    <circle cx="55"  cy="75" r="3.5" />
    <circle cx="96"  cy="38" r="3.5" />
    <circle cx="170" cy="52" r="3.5" />
  </g>

  <!-- Central chip body -->
  <rect
    x="108" y="44"
    width="22" height="18"
    rx="3"
    fill={bodyFill}
    stroke={accentStroke}
    stroke-width="2"
  />

  <!-- Chip pins — top -->
  <g stroke={accentStroke} stroke-width="1.5" stroke-linecap="round">
    <line x1="113" y1="44" x2="113" y2="38" />
    <line x1="119" y1="44" x2="119" y2="38" />
    <line x1="125" y1="44" x2="125" y2="38" />
    <!-- Chip pins — bottom -->
    <line x1="113" y1="62" x2="113" y2="68" />
    <line x1="119" y1="62" x2="119" y2="68" />
    <line x1="125" y1="62" x2="125" y2="68" />
  </g>
</svg>
