---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = 'Benthic OPS — Inteligencia Operativa y Arquitectura Tecnológica a la Medida. IA, Software a medida y Ciberseguridad para empresas en Chile.',
  currentPage = '/'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/orca-color.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="ocean-bg min-h-screen relative">

    <!-- Burbujas de fondo -->
    <div aria-hidden="true" id="bubbles-container">
      <div class="bubble" style="left:8%;  width:10px; height:10px; --duration:9s;  --delay:0s;"></div>
      <div class="bubble" style="left:18%; width:6px;  height:6px;  --duration:12s; --delay:2s;"></div>
      <div class="bubble" style="left:30%; width:14px; height:14px; --duration:8s;  --delay:4s;"></div>
      <div class="bubble" style="left:45%; width:8px;  height:8px;  --duration:11s; --delay:1s;"></div>
      <div class="bubble" style="left:60%; width:12px; height:12px; --duration:10s; --delay:3s;"></div>
      <div class="bubble" style="left:72%; width:7px;  height:7px;  --duration:13s; --delay:0.5s;"></div>
      <div class="bubble" style="left:85%; width:10px; height:10px; --duration:9s;  --delay:5s;"></div>
      <div class="bubble" style="left:93%; width:5px;  height:5px;  --duration:14s; --delay:2.5s;"></div>
    </div>

    <!-- Rayo de luz superficial -->
    <div class="depth-ray" aria-hidden="true"></div>

    <!-- Navbar -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
      <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group" aria-label="Benthic OPS - Inicio">
          <img
            src="/orca-color.png"
            alt="Orca con circuitos"
            width="48"
            height="48"
            class="object-contain transition-transform duration-300 group-hover:scale-110"
          />
          <div class="flex flex-col leading-tight">
            <span style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.15rem; color: #e8f4ff; letter-spacing: 0.04em;">
              BENTHIC
            </span>
            <span style="font-family: 'Space Grotesk', sans-serif; font-weight: 400; font-size: 0.7rem; color: #00d4ff; letter-spacing: 0.18em; text-transform: uppercase;">
              OPS
            </span>
          </div>
        </a>

        <!-- Nav links desktop -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/" class={`nav-link ${currentPage === '/' ? 'active' : ''}`}>
            Inicio
          </a>
          <a href="/nosotros" class={`nav-link ${currentPage === '/nosotros' ? 'active' : ''}`}>
            Nosotros
          </a>

          <!-- Servicios dropdown -->
          <div class="relative group">
            <button
              class={`nav-link flex items-center gap-1 bg-transparent border-0 cursor-pointer ${
                ['/analytics','/software','/consulting'].includes(currentPage) ? 'active' : ''
              }`}
            >
              Servicios
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="transition-transform duration-200 group-hover:rotate-180">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
            <div
              class="absolute top-full left-1/2 -translate-x-1/2 mt-3 w-56 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 dropdown-bridge"
              style="background:rgba(5,22,80,0.97); backdrop-filter:blur(20px); border:1px solid rgba(0,212,255,0.18); border-radius:0.75rem; padding:0.5rem;"
            >
              <a href="/analytics" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors hover:bg-cyan-900/20" style="color:#a8c4e0;">
                <span>📊</span> Analytics & IA
              </a>
              <a href="/software" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors hover:bg-cyan-900/20" style="color:#a8c4e0;">
                <span>💻</span> Custom Software
              </a>
              <a href="/consulting" class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors hover:bg-cyan-900/20" style="color:#a8c4e0;">
                <span>🛡️</span> Consultoría & Seguridad
              </a>
            </div>
          </div>

          <a href="/contacto" class="btn-primary text-sm py-2 px-4">
            Contacto
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button
          id="menu-toggle"
          class="md:hidden flex flex-col gap-1.5 p-2"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-6 h-0.5 bg-white/70 transition-all duration-300" id="bar1"></span>
          <span class="block w-6 h-0.5 bg-white/70 transition-all duration-300" id="bar2"></span>
          <span class="block w-6 h-0.5 bg-white/70 transition-all duration-300" id="bar3"></span>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="md:hidden hidden flex-col gap-1 px-4 pb-6 pt-2"
        style="background: rgba(5,22,80,0.97); backdrop-filter: blur(20px);"
      >
        <a href="/" class="nav-link text-base py-3 px-2 border-b border-white/10 block">Inicio</a>
        <a href="/nosotros" class="nav-link text-base py-3 px-2 border-b border-white/10 block">Nosotros</a>
        <div class="py-2 px-2 border-b border-white/10">
          <div class="text-xs uppercase tracking-widest mb-2" style="color:#00d4ff;">Servicios</div>
          <a href="/analytics" class="nav-link text-sm py-1.5 block pl-2">📊 Analytics & IA</a>
          <a href="/software" class="nav-link text-sm py-1.5 block pl-2">💻 Custom Software</a>
          <a href="/consulting" class="nav-link text-sm py-1.5 block pl-2">🛡️ Consultoría</a>
        </div>
        <a href="/contacto" class="btn-primary text-sm justify-center mt-3">Contacto</a>
      </div>
    </header>

    <!-- Contenido principal -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer style="background: #000515; border-top: 1px solid rgba(0,212,255,0.1);">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
          <!-- Brand -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <img src="/orca-white.png" alt="" width="36" height="36" class="object-contain opacity-80" />
              <span style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1rem; color: #e8f4ff; letter-spacing: 0.06em;">
                BENTHIC OPS
              </span>
            </div>
            <p class="text-sm leading-relaxed" style="color: #7aa3cc;">
              Inteligencia Operativa y Arquitectura Tecnológica a la Medida para empresas en crecimiento.
            </p>
          </div>

          <!-- Servicios -->
          <div>
            <h3 class="text-sm font-semibold mb-4 uppercase tracking-widest" style="color: #00d4ff;">Servicios</h3>
            <ul class="space-y-2">
              <li><a href="/analytics" class="text-sm hover:text-cyan-300 transition-colors" style="color:#7aa3cc;">Analytics & Predictive AI</a></li>
              <li><a href="/software" class="text-sm hover:text-cyan-300 transition-colors" style="color:#7aa3cc;">Custom Software & Systems</a></li>
              <li><a href="/consulting" class="text-sm hover:text-cyan-300 transition-colors" style="color:#7aa3cc;">Consulting & Cyber Security</a></li>
            </ul>
          </div>

          <!-- Contacto -->
          <div>
            <h3 class="text-sm font-semibold mb-4 uppercase tracking-widest" style="color: #00d4ff;">Contacto</h3>
            <ul class="space-y-2 text-sm" style="color:#7aa3cc;">
              <li>📍 Santiago, Chile</li>
              <li>✉️ contacto@benthicops.cl</li>
              <li>📱 +56 9 XXXX XXXX</li>
            </ul>
          </div>
        </div>

        <div class="border-t pt-6 flex flex-col md:flex-row items-center justify-between gap-4" style="border-color: rgba(0,212,255,0.1);">
          <p class="text-xs" style="color:#7aa3cc;">© 2025 Benthic OPS SpA. Todos los derechos reservados.</p>
          <div class="flex items-center gap-1 text-xs" style="color:#7aa3cc;">
            <span>Operando desde las profundidades de</span>
            <span style="color:#00d4ff;">Chile 🌊</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Widgets Interactivos de Profundidad (Inmersión) -->
    <div id="depth-meter-widget" class="fixed bottom-6 left-6 z-40 hidden md:flex flex-col gap-1 p-4 rounded-xl glass-card border border-cyan/20 bg-deep-black/60 backdrop-blur-md transition-all duration-300">
      <div class="flex items-baseline gap-1">
        <span id="depth-number" style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.6rem; color:#00d4ff; text-shadow:0 0 10px rgba(0,212,255,0.4);">0</span>
        <span class="text-xs font-semibold text-cyan">METROS</span>
      </div>
      <div class="text-[0.65rem] tracking-widest text-text-muted uppercase font-bold" id="depth-zone-name">
        Zona Epipelágica
      </div>
      <!-- Indicador visual vertical -->
      <div class="w-full h-1 bg-deep-black/40 rounded-full mt-2 overflow-hidden relative">
        <div id="depth-progress-bar" class="absolute top-0 left-0 bottom-0 bg-cyan transition-all duration-100" style="width: 0%;"></div>
      </div>
    </div>

    <style>
      /* Dinámica de opacidad y brillo global basada en scroll */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.4) 100%);
        pointer-events: none;
        opacity: var(--scroll-shadow-opacity, 0.2);
        transition: opacity 0.1s ease;
      }
    </style>

  </body>
</html>

<script>
  // ── Navbar scroll effect ──
  const navbar = document.getElementById('navbar');
  const depthNumber = document.getElementById('depth-number');
  const depthZoneName = document.getElementById('depth-zone-name');
  const depthProgressBar = document.getElementById('depth-progress-bar');
  const depthWidget = document.getElementById('depth-meter-widget');

  // Configuración de zonas
  const ZONAS = [
    { limit: 200, name: 'Zona Epipelágica (Superficie)' },
    { limit: 1000, name: 'Zona Mesopelágica' },
    { limit: 3000, name: 'Zona Batipelágica' },
    { limit: 4000, name: 'Zona Béntica (Abisal)' }
  ];

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    
    // Navbar style on scroll
    if (scrollY > 40) {
      navbar?.setAttribute('style',
        'background: rgba(5,22,80,0.92); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0,212,255,0.12);'
      );
    } else {
      navbar?.setAttribute('style', '');
    }

    // Calcular progreso de scroll total
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight > 0) {
      const pct = Math.min(1, Math.max(0, scrollY / docHeight));
      
      // Activar widget si el usuario empieza a bajar
      if (pct > 0.02) {
        depthWidget?.classList.remove('hidden');
        depthWidget?.classList.add('flex');
      } else {
        depthWidget?.classList.add('hidden');
        depthWidget?.classList.remove('flex');
      }

      // Calcular metros de profundidad (0 a 4000 metros)
      const currentDepth = Math.round(pct * 4000);
      
      if (depthNumber) depthNumber.textContent = currentDepth.toLocaleString();
      if (depthProgressBar) depthProgressBar.style.width = `${pct * 100}%`;

      // Actualizar nombre de la zona
      if (depthZoneName) {
        const zona = ZONAS.find(z => currentDepth <= z.limit) || ZONAS[ZONAS.length - 1];
        depthZoneName.textContent = zona.name;
      }

      // Actualizar viñeta e inmersión global (brillo del fondo se oscurece al bajar)
      document.body.style.setProperty('--scroll-shadow-opacity', String(0.1 + pct * 0.75));

      // Parallax e inmersión tridimensional de fondos
      document.querySelectorAll('.section-bg').forEach((bg) => {
        const htmlBg = bg as HTMLElement;
        const rect = htmlBg.parentElement?.getBoundingClientRect();
        if (rect) {
          // Si la sección está total o parcialmente en la pantalla
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            // Calcular posición relativa del elemento (-1 a 1)
            const parentHeight = rect.height;
            const scrollPercent = (window.innerHeight - rect.top) / (window.innerHeight + parentHeight);
            
            // Mover la imagen dentro de su rango de seguridad (top: -20% a 20%)
            // Como la imagen tiene height: 140% y top: -20%, tenemos un rango de ±20%
            const maxOffsetPct = 12; // Mover máximo 12% verticalmente
            const yOffset = (scrollPercent - 0.5) * -2 * maxOffsetPct;
            
            htmlBg.style.transform = `translate3d(0, ${yOffset}%, 0)`;
          }
        }
      });
    }
  });

  // ── Mobile menu ──
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');
  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      bar1!.style.transform = 'rotate(45deg) translate(5px, 5px)';
      bar2!.style.opacity = '0';
      bar3!.style.transform = 'rotate(-45deg) translate(5px, -5px)';
    } else {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
      bar1!.style.transform = '';
      bar2!.style.opacity = '1';
      bar3!.style.transform = '';
    }
  });

  // ── Scroll reveal (IntersectionObserver) globally active ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.10 } // Trigger early
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
