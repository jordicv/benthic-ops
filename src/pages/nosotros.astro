---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Nosotros — Benthic OPS"
  description="Conoce al equipo detrás de Benthic OPS. Somos especialistas en IA, software a medida y ciberseguridad para empresas en crecimiento en Chile y Alemania."
  currentPage="/nosotros"
>

  <!-- ═══════════════════════════════════════
       HERO NOSOTROS
  ═══════════════════════════════════════ -->
  <section class="relative pt-36 pb-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-hero" style="opacity:0.28;"></div>
    <div class="section-overlay" style="background:rgba(0,7,45,0.8);"></div>
    <div class="max-w-4xl mx-auto text-center relative" style="z-index:2;">
      <span class="section-label mb-6 inline-flex load-fade-in">Quiénes somos</span>
      <h1 class="load-fade-in delay-100" style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(2rem,5vw,3rem); line-height:1.15; color:#e8f4ff; margin:0 0 1.25rem;">
        Navegamos la profundidad
        <span style="color:#00d4ff; display:block;">de tu operación</span>
      </h1>
      <p class="text-lg leading-relaxed max-w-2xl mx-auto load-fade-in delay-200" style="color:#7aa3cc;">
        Somos un equipo de ingenieros, analistas y expertos en ciberseguridad con una misión clara: 
        hacer que la tecnología trabaje para ti, no al revés.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       NUESTRA HISTORIA
  ═══════════════════════════════════════ -->
  <section class="relative py-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-bio" style="opacity:0.18;"></div>
    <div class="section-overlay" style="background:rgba(0,5,25,0.85);"></div>
    <div class="relative" style="z-index:2;">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="reveal">
            <span class="section-label mb-5 inline-flex">Origen</span>
            <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.8rem; color:#e8f4ff; margin:0.5rem 0 1rem;">
              Nacimos en Chile y Alemania para resolver problemas reales
            </h2>
            <p class="text-base leading-relaxed mb-4" style="color:#7aa3cc;">
              Benthic OPS nació de una frustración concreta: ver cómo empresas con potencial real eran frenadas por datos desordenados, herramientas genéricas que no encajaban y procesos manuales que consumían horas valiosas.
            </p>
            <p class="text-base leading-relaxed mb-4" style="color:#7aa3cc;">
              El nombre viene de la <strong style="color:#e8f4ff;">zona béntica</strong> — la parte más profunda del océano, donde existe vida compleja y organizada lejos de la superficie. Así trabajamos nosotros: en las capas más profundas de tu operación, donde está el verdadero potencial de mejora.
            </p>
            <p class="text-base leading-relaxed" style="color:#7aa3cc;">
              Operamos de forma integrada en Chile y Alemania, enfocándonos en empresas que manejan volúmenes significativos de datos y procesos, y que necesitan pasar al siguiente nivel sin depender de soluciones masivas y costosas.
            </p>
          </div>

          <!-- Visual de profundidad -->
          <div class="reveal flex flex-col gap-4" style="transition-delay:150ms;">
            {[
              { depth: '0m', label: 'Superficie', desc: 'Reunión inicial y diagnóstico de tu operación' },
              { depth: '200m', label: 'Mesopelágico', desc: 'Análisis profundo y diseño de soluciones' },
              { depth: '1000m', label: 'Batipelágico', desc: 'Implementación y automatización' },
              { depth: '4000m', label: 'Béntico', desc: 'Control total y optimización continua' },
            ].map(({ depth, label, desc }, i) => (
              <div
                class="glass-card p-4 flex items-center gap-5"
                style={`transition-delay:${i * 100 + 150}ms; border-left: 3px solid rgba(0,212,255,${0.3 + i * 0.15});`}
              >
                <div class="flex-shrink-0 text-center" style="min-width:60px;">
                  <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:0.85rem; color:#00d4ff;">
                    {depth}
                  </div>
                  <div class="text-xs" style="color:#7aa3cc;">{label}</div>
                </div>
                <div>
                  <p class="text-sm" style="color:#a8c4e0;">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       MISIÓN / VISIÓN / VALORES
  ═══════════════════════════════════════ -->
  <section class="relative py-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-abyss" style="opacity:0.3;"></div>
    <div class="section-overlay" style="background:rgba(0,5,25,0.8);"></div>
    <div class="relative" style="z-index:2;">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14 reveal">
          <span class="section-label mb-4 inline-flex">Propósito</span>
          <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(1.6rem,4vw,2.2rem); color:#e8f4ff; margin:0.5rem 0;">
            Lo que nos mueve
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            {
              svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>`,
              title: 'Misión',
              text: 'Transformar la complejidad operativa de empresas en crecimiento en ventajas competitivas reales, usando tecnología avanzada y soluciones 100% a la medida de cada cliente.',
              delay: 0,
            },
            {
              svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`,
              title: 'Visión',
              text: 'Ser el referente en inteligencia operativa para medianas empresas latinoamericanas, expandiendo desde Chile hacia el resto de la región con presencia local en cada mercado.',
              delay: 120,
            },
            {
              svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V8M5 12H2a10 10 0 0 0 20 0h-3"></path><circle cx="12" cy="5" r="3"></circle></svg>`,
              title: 'Valores',
              text: 'Claridad sobre complejidad. Velocidad sin descuido. Integración sin fricción. Resultados medibles. Y sobre todo: respeto por el tiempo y los recursos de cada cliente.',
              delay: 240,
            },
          ].map(({ svg, title, text, delay }) => (
            <div class="glass-card reveal p-8 text-center flex flex-col items-center" style={`transition-delay:${delay}ms;`}>
              <div class="p-3 rounded-xl border border-cyan/20 bg-cyan-950/5 mb-5 flex items-center justify-center" style="filter: drop-shadow(0 0 5px rgba(0,212,255,0.45));">
                <Fragment set:html={svg} />
              </div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.1rem; color:#e8f4ff; margin:0 0 0.75rem;">{title}</h3>
              <p class="text-sm leading-relaxed" style="color:#7aa3cc;">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       POR QUÉ ELEGIRNOS
  ═══════════════════════════════════════ -->
  <section class="relative py-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-bio" style="opacity:0.25;"></div>
    <div class="section-overlay" style="background:rgba(0,5,25,0.85);"></div>
    <div class="relative" style="z-index:2;">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14 reveal">
          <span class="section-label mb-4 inline-flex">Diferencias</span>
          <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(1.6rem,4vw,2.2rem); color:#e8f4ff; margin:0.5rem 0;">
            Por qué Benthic OPS y no una consultora tradicional
          </h2>
        </div>

        <div class="glass-card reveal overflow-hidden" style="border-color: rgba(0, 212, 255, 0.15); margin-top: 2rem;">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" style="min-width: 650px; margin: 0;">
              <thead>
                <tr style="border-bottom: 2px solid rgba(0, 212, 255, 0.2); background: rgba(0, 15, 60, 0.4);">
                  <th class="py-4 px-6 text-xs uppercase tracking-wider" style="color: #7aa3cc; font-weight: 700; font-family: 'Space Grotesk', sans-serif;">Criterio</th>
                  <th class="py-4 px-6 text-xs uppercase tracking-wider" style="color: #ff9090; font-weight: 700; font-family: 'Space Grotesk', sans-serif;">Otras empresas / Consultoras</th>
                  <th class="py-4 px-6 text-xs uppercase tracking-wider" style="color: #00d4ff; font-weight: 700; font-family: 'Space Grotesk', sans-serif; background: rgba(0, 212, 255, 0.04);">Benthic OPS</th>
                </tr>
              </thead>
              <tbody style="color: #a8c4e0;">
                {[
                  {
                    crit: 'Tiempo de respuesta',
                    trad: 'Proyectos de 6-12 meses antes de ver resultados tangibles.',
                    benthic: 'Primeros resultados e integraciones activas en las primeras semanas.'
                  },
                  {
                    crit: 'Entregables',
                    trad: 'Reportes extensos, manuales densos y diapositivas de diagnóstico.',
                    benthic: 'Reportes ejecutivos de 3 párrafos directo a tu WhatsApp semanalmente.'
                  },
                  {
                    crit: 'Desarrollo',
                    trad: 'Soluciones genéricas de caja o softwares rígidos adaptados con calzador.',
                    benthic: 'Software, automatizaciones y bots a la medida de tu flujo operativo.'
                  },
                  {
                    crit: 'Costos',
                    trad: 'Equipos sobredimensionados con altos costos fijos y mantenciones elevadas.',
                    benthic: 'Modelo flexible por hitos concretos: pagas por lo que tu negocio necesita.'
                  },
                  {
                    crit: 'Integración',
                    trad: 'Obligan a reemplazar sistemas o declaran incompatibilidad de plataformas.',
                    benthic: 'Nos adaptamos a tu flujo e infraestructura actual sin interrupciones.'
                  },
                  {
                    crit: 'Enfoque',
                    trad: 'Métricas de vanidad, teoría de negocio y análisis a nivel macro.',
                    benthic: 'Métricas que importan: tiempo ahorrado, costo recuperado y decisiones claras.'
                  }
                ].map(({ crit, trad, benthic }) => (
                  <tr style="border-bottom: 1px solid rgba(0, 212, 255, 0.08); transition: background-color 0.2s ease;" class="hover:bg-cyan-950/10">
                    <td class="py-4 px-6 text-sm font-semibold" style="color: #e8f4ff; font-family: 'Space Grotesk', sans-serif;">{crit}</td>
                    <td class="py-4 px-6 text-sm" style="color: #7aa3cc;">{trad}</td>
                    <td class="py-4 px-6 text-sm font-medium" style="color: #e8f4ff; background: rgba(0, 212, 255, 0.02); border-left: 1px solid rgba(0, 212, 255, 0.05); border-right: 1px solid rgba(0, 212, 255, 0.05);">{benthic}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       ÁREAS QUE CUBRIMOS
  ═══════════════════════════════════════ -->
  <section class="relative py-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-abyss" style="opacity:0.35;"></div>
    <div class="section-overlay" style="background:rgba(0,7,45,0.82);"></div>
    <div class="relative" style="z-index:2;">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14 reveal">
          <span class="section-label mb-4 inline-flex">Expertise</span>
          <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(1.6rem,4vw,2.2rem); color:#e8f4ff; margin:0.5rem 0;">
            Nuestras capacidades técnicas
          </h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {[
            'Inteligencia Artificial',
            'Business Intelligence',
            'Cloud Architecture',
            'Ciberseguridad',
            'Automatización RPA',
            'APIs & Integraciones',
            'Bases de Datos',
            'WhatsApp Business',
            'Desarrollo Web',
            'Mercado Público',
            'Integración SII',
            'Auditoría Digital',
          ].map((cap, i) => (
            <div class="glass-card reveal px-4 py-4 text-sm text-center" style={`color:#a8c4e0; transition-delay:${i * 40}ms;`}>
              {cap}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="relative py-16 px-6 text-center overflow-hidden">
    <div class="section-bg section-bg-hero" style="opacity:0.22;"></div>
    <div class="section-overlay" style="background:rgba(0,7,45,0.85);"></div>
    <div class="max-w-2xl mx-auto reveal relative" style="z-index:2;">
      <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.8rem; color:#e8f4ff; margin:0 0 1rem;">
        ¿Listos para trabajar juntos?
      </h2>
      <p class="text-base mb-8" style="color:#7aa3cc;">
        Cuéntanos tu desafío y te mostramos en concreto cómo podemos resolverlo.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contacto" class="btn-primary">Ir a Contacto →</a>
        <a href="/#servicios" class="btn-outline">Ver servicios</a>
      </div>
    </div>
  </section>

</Layout>
