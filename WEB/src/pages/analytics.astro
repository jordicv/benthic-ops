---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Analytics & Predictive AI — Benthic OPS"
  description="Automatización de datos, radar de licitaciones 24/7 e integración con SII. El cerebro predictivo y financiero de tu empresa."
  currentPage="/analytics"
>

  <!-- Hero de servicio -->
  <section class="relative pt-36 pb-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-hero" style="opacity:0.3;"></div>
    <div class="section-overlay" style="background:rgba(0,7,45,0.78);"></div>
    <div class="max-w-4xl mx-auto text-center relative" style="z-index:2;">
      <span class="section-label mb-6 inline-flex load-fade-in">Analytics & Predictive AI</span>
      <div class="flex justify-center mb-8 load-fade-in">
        <div class="p-5 rounded-2xl border border-cyan/20 bg-cyan-950/10 shadow-[0_0_30px_rgba(0,212,255,0.12)]">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 0 8px rgba(0,212,255,0.6));">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
        </div>
      </div>
      <h1 class="load-fade-in delay-100" style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(2rem,5vw,3rem); line-height:1.15; color:#e8f4ff; margin:0 0 1.25rem;">
        El cerebro predictivo
        <span style="color:#00d4ff; display:block;">de tu empresa</span>
      </h1>
      <p class="text-lg leading-relaxed max-w-2xl mx-auto load-fade-in delay-200" style="color:#7aa3cc;">
        Transformamos datos dispersos y procesos manuales en reportes ejecutivos simples y predicciones estratégicas mediante Inteligencia Artificial de vanguardia.
      </p>

      <div class="flex flex-wrap gap-4 justify-center mt-8 load-fade-in delay-300">
        <a href="#servicios" class="btn-primary">Ver qué hacemos →</a>
        <a href="#contacto" class="btn-outline">Solicitar diagnóstico</a>
      </div>
    </div>
  </section>

  <!-- Sub-servicios -->
  <section id="servicios" class="relative py-20 px-6 overflow-hidden">
    <div class="section-bg section-bg-bio" style="opacity:0.2;"></div>
    <div class="section-overlay" style="background:rgba(0,5,30,0.85);"></div>
    <div class="relative" style="z-index:2;">
      <div class="max-w-5xl mx-auto space-y-8">
        <div class="text-center mb-14 reveal">
          <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.8rem; color:#e8f4ff; margin:0 0 0.75rem;">
            Qué incluye este servicio
          </h2>
          <p style="color:#7aa3cc;">Tres módulos que operan solos o integrados según tu necesidad.</p>
        </div>

        <!-- Módulo 1 -->
        <div class="glass-card reveal p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <span class="section-label mb-4 inline-flex">Módulo 1</span>
            <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.3rem; color:#e8f4ff; margin:0.5rem 0;">
              Automatización de Datos
            </h3>
            <p class="text-sm leading-relaxed mb-4" style="color:#7aa3cc;">
              Conexión automatizada en tiempo real con el SII para la extracción del Registro de Compras y Ventas. Procesamiento documental inteligente donde arrastras tus archivos y la IA los concilia de inmediato.
            </p>
            <ul class="space-y-2">
              {[
                'Integración directa con SII (APIs y scraping propio)',
                'Conciliación automática desde Google Drive / OneDrive',
                'Detección de errores y discrepancias en tiempo real',
                'Dashboard de IVA acumulado con alertas automáticas',
              ].map(f => (
                <li class="flex items-start gap-2 text-sm" style="color:#a8c4e0;">
                  <span style="color:#00d4ff; flex-shrink:0;">▸</span>{f}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex justify-center">
            <div class="glass-card p-6 text-center flex flex-col items-center" style="max-width:220px; border-color: rgba(0,212,255,0.3);">
              <div class="p-3 rounded-xl border border-cyan/20 bg-cyan-950/5 mb-3 flex items-center justify-center" style="filter: drop-shadow(0 0 5px rgba(0,212,255,0.45));">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </div>
              <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.1rem; color:#00d4ff;">En tiempo real</div>
              <div class="text-sm mt-1" style="color:#7aa3cc;">Sin exportaciones manuales</div>
            </div>
          </div>
        </div>

        <!-- Módulo 2 -->
        <div class="glass-card reveal p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="order-2 md:order-1 flex justify-center">
            <div class="glass-card p-6 text-center flex flex-col items-center" style="max-width:220px; border-color: rgba(0,212,255,0.3);">
              <div class="p-3 rounded-xl border border-cyan/20 bg-cyan-950/5 mb-3 flex items-center justify-center" style="filter: drop-shadow(0 0 5px rgba(0,212,255,0.45));">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="6"></circle>
                  <circle cx="12" cy="12" r="2"></circle>
                </svg>
              </div>
              <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.1rem; color:#00d4ff;">+40 páginas</div>
              <div class="text-sm mt-1" style="color:#7aa3cc;">de bases analizadas en segundos</div>
            </div>
          </div>
          <div class="order-1 md:order-2">
            <span class="section-label mb-4 inline-flex">Módulo 2</span>
            <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.3rem; color:#e8f4ff; margin:0.5rem 0;">
              Radar de Licitaciones
            </h3>
            <p class="text-sm leading-relaxed mb-4" style="color:#7aa3cc;">
              Monitoreo 24/7 de Mercado Público. Nuestra IA analiza bases de licitación complejas de más de 40 páginas, filtra los requisitos y te notifica solo las oportunidades reales de ganar.
            </p>
            <ul class="space-y-2">
              {[
                'API oficial de ChileCompra + Mercado Público',
                'Filtro inteligente por rubro, monto y probabilidad',
                'Notificaciones solo de oportunidades reales',
                'Resumen ejecutivo de la base en 3 minutos',
              ].map(f => (
                <li class="flex items-start gap-2 text-sm" style="color:#a8c4e0;">
                  <span style="color:#00d4ff; flex-shrink:0;">▸</span>{f}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Módulo 3 -->
        <div class="glass-card reveal p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <span class="section-label mb-4 inline-flex">Módulo 3</span>
            <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.3rem; color:#e8f4ff; margin:0.5rem 0;">
              Reportabilidad Simple
            </h3>
            <p class="text-sm leading-relaxed mb-4" style="color:#7aa3cc;">
              Olvídate de los paneles enredados. Recibe un resumen ejecutivo de tres párrafos en texto simple directo en tu WhatsApp cada lunes para saber exactamente cuánto IVA acumulas y qué decisiones tomar.
            </p>
            <ul class="space-y-2">
              {[
                'Reporte semanal vía WhatsApp Business API oficial',
                '3 párrafos: estado actual, alertas y acción recomendada',
                'Sin dashboards complejos que nadie lee',
                'Histórico consultable en cualquier momento',
              ].map(f => (
                <li class="flex items-start gap-2 text-sm" style="color:#a8c4e0;">
                  <span style="color:#00d4ff; flex-shrink:0;">▸</span>{f}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex justify-center">
            <div class="glass-card p-6 text-center flex flex-col items-center" style="max-width:220px; border-color: rgba(0,212,255,0.3);">
              <div class="p-3 rounded-xl border border-cyan/20 bg-cyan-950/5 mb-3 flex items-center justify-center" style="filter: drop-shadow(0 0 5px rgba(0,212,255,0.45));">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
              </div>
              <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.1rem; color:#00d4ff;">Cada lunes</div>
              <div class="text-sm mt-1" style="color:#7aa3cc;">Directo a tu WhatsApp</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Métricas de impacto -->
  <section class="relative py-16 px-6 overflow-hidden">
    <div class="section-bg section-bg-abyss" style="opacity:0.25;"></div>
    <div class="section-overlay" style="background:rgba(0,7,45,0.85);"></div>
    <div class="max-w-4xl mx-auto relative" style="z-index:2;">
      <div class="glass-card reveal p-10">
        <h3 class="text-center mb-10" style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.4rem; color:#e8f4ff;">
          Lo que automatizamos en tu empresa
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          
          <!-- 1. Reducción tiempo reportes: HIGHER IS BETTER (Subiendo) -->
          <div class="flex flex-col items-center">
            <span class="inline-flex items-center gap-1 text-[0.65rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full mb-2 bg-emerald-900/30 text-emerald-300 border border-emerald-500/30">
              <span class="text-emerald-400">↑</span> Higher is Better
            </span>
            <div 
              class="animate-counter" 
              data-direction="up" 
              data-start="0" 
              data-target="80" 
              data-suffix="%"
              style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:2rem; color:#00d4ff;"
            >
              0%
            </div>
            <div class="text-xs mt-1" style="color:#7aa3cc;">Reducción en tiempo de reportes</div>
          </div>

          <!-- 2. Monitoreo: 24/7 Continuo -->
          <div class="flex flex-col items-center justify-between">
            <span class="inline-flex items-center gap-1 text-[0.65rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full mb-2 bg-cyan-900/30 text-cyan-300 border border-cyan-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span> Continuo
            </span>
            <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:2rem; color:#00d4ff;">
              24/7
            </div>
            <div class="text-xs mt-1" style="color:#7aa3cc;">Monitoreo de licitaciones</div>
          </div>

          <!-- 3. Análisis de base: LOWEST IS BETTER (Bajando) -->
          <div class="flex flex-col items-center">
            <span class="inline-flex items-center gap-1 text-[0.65rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full mb-2 bg-cyan-900/30 text-cyan-300 border border-cyan-500/30">
              <span class="text-cyan-400">↓</span> Lowest is Better
            </span>
            <div 
              class="animate-counter" 
              data-direction="down" 
              data-start="60" 
              data-target="3" 
              data-prefix="< " 
              data-suffix=" min"
              style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:2rem; color:#00d4ff;"
            >
              < 60 min
            </div>
            <div class="text-xs mt-1" style="color:#7aa3cc;">Análisis de base licitación</div>
          </div>

          <!-- 4. Integración SII: HIGHER IS BETTER (Subiendo) -->
          <div class="flex flex-col items-center">
            <span class="inline-flex items-center gap-1 text-[0.65rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full mb-2 bg-emerald-900/30 text-emerald-300 border border-emerald-500/30">
              <span class="text-emerald-400">↑</span> Higher is Better
            </span>
            <div 
              class="animate-counter" 
              data-direction="up" 
              data-start="0" 
              data-target="100" 
              data-suffix="%"
              style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:2rem; color:#00d4ff;"
            >
              0%
            </div>
            <div class="text-xs mt-1" style="color:#7aa3cc;">Integración SII automatizada</div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <ContactForm page="analytics" />
</Layout>
