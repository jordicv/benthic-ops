---
// Neural Network Canvas Animation Component
// Draws animated nodes + connections + data packets flowing through
---

<div class="neural-wrapper" aria-hidden="true">
  <canvas id="neural-canvas"></canvas>
  <div class="neural-label">
    <span class="neural-dot"></span>
    Red Neuronal Activa
  </div>
</div>

<style>
.neural-wrapper {
  position: relative;
  width: 100%;
  height: 420px;
  overflow: hidden;
  border-radius: 1.25rem;
  border: 1px solid rgba(0,212,255,0.15);
  background: rgba(0,5,21,0.6);
  backdrop-filter: blur(8px);
}

#neural-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.neural-label {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.7rem;
  color: rgba(0,212,255,0.7);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
}

.neural-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #00d4ff;
  animation: pulse-dot 1.5s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.6); }
}
</style>

<script>
(function() {
  const canvas = document.getElementById('neural-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  // ── Config ──
  const NODE_COUNT = 48;
  const CONNECTION_DIST = 140;
  const PACKET_SPEED = 1.4;
  const COLORS = {
    node:       'rgba(0,212,255,',
    line:       'rgba(0,212,255,',
    packet:     '#00d4ff',
    glow:       'rgba(0,180,255,0.35)',
    highlight:  '#ffffff',
  };

  // ── Types ──
  interface Node {
    x: number; y: number;
    vx: number; vy: number;
    r: number;
    pulse: number;
    pulseSpeed: number;
    active: boolean;
  }
  interface Packet {
    fromIdx: number;
    toIdx: number;
    progress: number;
    speed: number;
    color: string;
  }

  let W = 0, H = 0;
  let nodes: Node[] = [];
  let packets: Packet[] = [];
  let frame = 0;
  let raf: number;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Init ──
  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    W = rect.width;
    H = rect.height;
    canvas.width  = W * window.devicePixelRatio;
    canvas.height = H * window.devicePixelRatio;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    ctx!.scale(window.devicePixelRatio, window.devicePixelRatio);
  }

  function initNodes() {
    nodes = Array.from({ length: NODE_COUNT }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.35,
      vy: (Math.random() - 0.5) * 0.35,
      r: 2 + Math.random() * 3.5,
      pulse: Math.random() * Math.PI * 2,
      pulseSpeed: 0.02 + Math.random() * 0.03,
      active: Math.random() > 0.6,
    }));
  }

  function spawnPacket() {
    // Pick a random connected pair
    for (let tries = 0; tries < 20; tries++) {
      const fi = Math.floor(Math.random() * nodes.length);
      const ti = Math.floor(Math.random() * nodes.length);
      if (fi === ti) continue;
      const a = nodes[fi], b = nodes[ti];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (d < CONNECTION_DIST) {
        packets.push({
          fromIdx: fi, toIdx: ti,
          progress: 0,
          speed: PACKET_SPEED / d,
          color: Math.random() > 0.7 ? '#ffffff' : '#00d4ff',
        });
        break;
      }
    }
  }

  // ── Draw ──
  function draw() {
    ctx!.clearRect(0, 0, W, H);
    frame++;

    // spawn packets randomly
    if (frame % 18 === 0 && packets.length < 22) spawnPacket();

    // ── Move nodes ──
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      n.pulse += n.pulseSpeed;
      if (n.x < 0 || n.x > W) n.vx *= -1;
      if (n.y < 0 || n.y > H) n.vy *= -1;
    }

    // ── Draw connections ──
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d > CONNECTION_DIST) continue;
        const alpha = (1 - d / CONNECTION_DIST) * 0.3;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.strokeStyle = COLORS.line + alpha + ')';
        ctx!.lineWidth = 0.8;
        ctx!.stroke();
      }
    }

    // ── Draw packets ──
    packets = packets.filter(p => {
      p.progress += p.speed;
      if (p.progress >= 1) return false;

      const a = nodes[p.fromIdx], b = nodes[p.toIdx];
      const x = a.x + (b.x - a.x) * p.progress;
      const y = a.y + (b.y - a.y) * p.progress;

      // Glow
      const grd = ctx!.createRadialGradient(x, y, 0, x, y, 8);
      grd.addColorStop(0, COLORS.glow);
      grd.addColorStop(1, 'transparent');
      ctx!.beginPath();
      ctx!.arc(x, y, 8, 0, Math.PI * 2);
      ctx!.fillStyle = grd;
      ctx!.fill();

      // Dot
      ctx!.beginPath();
      ctx!.arc(x, y, 2.5, 0, Math.PI * 2);
      ctx!.fillStyle = p.color;
      ctx!.fill();

      return true;
    });

    // ── Draw nodes ──
    for (const n of nodes) {
      const pulse = Math.sin(n.pulse);
      const alpha = n.active ? 0.7 + pulse * 0.3 : 0.25 + pulse * 0.15;
      const radius = n.r + (n.active ? pulse * 1.5 : 0);

      // Outer glow (active nodes only)
      if (n.active) {
        const grd = ctx!.createRadialGradient(n.x, n.y, 0, n.x, n.y, radius * 5);
        grd.addColorStop(0, `rgba(0,212,255,${0.15 + pulse * 0.08})`);
        grd.addColorStop(1, 'transparent');
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, radius * 5, 0, Math.PI * 2);
        ctx!.fillStyle = grd;
        ctx!.fill();
      }

      // Node body
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, radius, 0, Math.PI * 2);
      ctx!.fillStyle = COLORS.node + alpha + ')';
      ctx!.fill();

      // Inner bright core
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, radius * 0.4, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(255,255,255,${alpha * 0.6})`;
      ctx!.fill();
    }

    // Con movimiento reducido, dibujar un único frame estático (sin bucle)
    if (!reduceMotion) raf = requestAnimationFrame(draw);
  }

  // ── Visibility observer (pause when off-screen) ──
  const observer = new IntersectionObserver(
    entries => {
      if (entries[0].isIntersecting) {
        if (!raf && !reduceMotion) raf = requestAnimationFrame(draw);
      } else {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    },
    { threshold: 0.1 }
  );
  observer.observe(canvas);

  // ── Boot ──
  resize();
  initNodes();
  draw();

  window.addEventListener('resize', () => {
    cancelAnimationFrame(raf);
    resize();
    if (reduceMotion) draw();
    else raf = requestAnimationFrame(draw);
  });
})();
</script>
